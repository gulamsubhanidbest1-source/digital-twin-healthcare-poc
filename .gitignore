from __future__ import annotations

import pandas as pd
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, precision_score, roc_auc_score
from sklearn.model_selection import train_test_split


FEATURE_COLUMNS = [
    "age",
    "bmi",
    "sleep_hours",
    "resting_hr",
    "hrv",
    "spo2",
    "activity_score",
    "stress_index",
    "diabetes",
    "hypertension",
    "smoker",
]


def train_model(df: pd.DataFrame):
    X = df[FEATURE_COLUMNS]
    y = df["risk_label"]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.25, stratify=y, random_state=42
    )

    model = RandomForestClassifier(
        n_estimators=200,
        max_depth=7,
        min_samples_leaf=2,
        random_state=42,
    )

    model.fit(X_train, y_train)
    predictions = model.predict(X_test)

    metrics = {
        "accuracy": accuracy_score(y_test, predictions),
        "precision": precision_score(y_test, predictions, zero_division=0),
        "roc_auc": roc_auc_score(y_test, model.predict_proba(X_test)[:, 1]),
    }

    return model, metrics


def summarize_patient_risk(model, patient_row: dict):
    features = pd.DataFrame([patient_row])[FEATURE_COLUMNS]
    probability = model.predict_proba(features)[0, 1]

    explanation_parts = []
    if patient_row["resting_hr"] > 75:
        explanation_parts.append("elevated resting heart rate indicates reduced cardiovascular resilience.")
    if patient_row["sleep_hours"] < 6:
        explanation_parts.append("low sleep duration may limit recovery and increase short-term physiological stress.")
    if patient_row["hrv"] < 30:
        explanation_parts.append("lower HRV suggests reduced autonomic resilience and recovery capacity.")
    if patient_row["diabetes"]:
        explanation_parts.append("diabetes increases the risk of metabolic and cardiovascular instability.")
    if patient_row["hypertension"]:
        explanation_parts.append("hypertension compounds cardiovascular strain and risk.")
    if patient_row["smoker"]:
        explanation_parts.append("smoking status adds additional vascular and inflammatory risk.")
    if not explanation_parts:
        explanation_parts.append("The profile is relatively stable, but the model still captures moderate risk due to lifestyle and physiological signals.")

    explanation = "This patient is flagged due to " + " ".join(explanation_parts)
    return probability, explanation
